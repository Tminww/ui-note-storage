FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4010
COPY --chown=node:node src/env.mjs src/notionOAuth.mjs src/notionOAuthServer.mjs ./src/
USER node
EXPOSE 4010
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:4010/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "src/notionOAuthServer.mjs"]
