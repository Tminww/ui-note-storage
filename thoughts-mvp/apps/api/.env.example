# Copy this file to .env. Never commit real API keys.
PORT=4000
HOST=127.0.0.1
DB_PATH=./data/thoughts.sqlite
STORAGE_DRIVER=sqlite

# OpenRouter powers both DeepSeek (chat) and Jev (decisions).
OPENROUTER_API_KEY=

# Optional direct OpenAI-compatible provider adapters:
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=

# Optional alternative Decisions-compatible backend:
CUSTOM_DECISIONS_URL=
CUSTOM_DECISIONS_API_KEY=

# For web: leave unset on localhost. For LAN, use the exact web origin.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081
