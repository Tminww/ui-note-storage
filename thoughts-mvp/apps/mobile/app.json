{
  "expo": {
    "name": "Thoughts",
    "slug": "thoughts-ai-inbox",
    "scheme": "thoughts",
    "version": "0.3.2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F7FB",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "dev.thoughts.miniapp",
      "edgeToEdgeEnabled": true,
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#5B4FE0"
      }
    },
    "web": {
      "name": "Thoughts — AI Inbox",
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Разрешите доступ к микрофону для записи мыслей голосом.",
          "speechRecognitionPermission": "Разрешите распознавание речи для перевода голосовых мыслей в текст."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-sqlite",
      "expo-background-task"
    ],
    "runtimeVersion": "0.3.0",
    "updates": {
      "enabled": false,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "owner": "tminwws-team",
    "extra": {
      "eas": {
        "projectId": "5fd4e492-7922-4f9e-83e4-a6c9e8062dc2"
      }
    },
    "icon": "./assets/icon.png"
  }
}
