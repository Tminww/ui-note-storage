# Include this file in nginx's http context, e.g. sites-enabled.
limit_req_zone $binary_remote_addr zone=thoughts_oauth_per_ip:1m rate=5r/s;
log_format thoughts_oauth '$remote_addr $request_method $uri $status';

server {
    listen 80;
    server_name ${THOUGHTS_OAUTH_DOMAIN};
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/thoughts-notion-oauth-acme;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${THOUGHTS_OAUTH_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${THOUGHTS_OAUTH_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${THOUGHTS_OAUTH_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 4k;

    location /notion/oauth/ {
        limit_req zone=thoughts_oauth_per_ip burst=20 nodelay;
        limit_req_status 429;
        access_log /var/log/nginx/thoughts-oauth-access.log thoughts_oauth;
        # Upstream errors can otherwise include OAuth codes in request URLs.
        error_log /dev/null;
        proxy_pass http://127.0.0.1:4010;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 3s;
        proxy_read_timeout 25s;
    }

    location / { return 404; }
}
